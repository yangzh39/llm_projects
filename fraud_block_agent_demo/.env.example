# Required: select deepseek, openai, anthropic, or custom.
LLM_PROVIDER=

# Required for hosted providers. A custom local endpoint may omit the key.
LLM_API_KEY=

# Required: enter a model identifier supported by your provider.
LLM_MODEL=

# Required only for custom providers. Preset providers supply their endpoint.
# LLM_BASE_URL=

# Custom OpenAI-compatible endpoints normally use this style. Set it to
# anthropic only when the endpoint implements Anthropic's Messages API.
# LLM_API_STYLE=openai

# Disable when an OpenAI-compatible endpoint does not support response_format.
# The system prompt still requests JSON output.
# LLM_USE_JSON_MODE=true

# Existing DeepSeek users may continue using DEEPSEEK_API_KEY,
# DEEPSEEK_BASE_URL, and DEEPSEEK_MODEL instead of the generic variables.
