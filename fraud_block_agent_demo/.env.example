# Select a preset: deepseek, openai, anthropic, or custom.
LLM_PROVIDER=deepseek

# Required for OpenAI, Anthropic, and custom providers. DeepSeek can continue
# using the legacy DEEPSEEK_API_KEY variable shown below.
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=

# Custom OpenAI-compatible endpoints normally use this style. Set it to
# anthropic only when the endpoint implements Anthropic's Messages API.
# LLM_API_STYLE=openai

# Disable when an OpenAI-compatible endpoint does not support response_format.
# The system prompt still requests JSON output.
# LLM_USE_JSON_MODE=true

# Backward-compatible local DeepSeek configuration:
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
